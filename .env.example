# Scopus MCP Server Configuration
# Copy this file to .env and fill in your credentials

# Required: Scopus API Key
# Get your API key from: https://dev.elsevier.com/myapikey.html
SCOPUS_API_KEY=your_api_key_here

# Optional: Scopus API Base URL (default: https://api.elsevier.com)
# SCOPUS_API_BASE_URL=https://api.elsevier.com

# Optional: Content API Key (for full-text access if subscribed)
# SCOPUS_CONTENT_KEY=your_content_key_here

# Optional: Default limit for search results (default: 25)
# SCOPUS_DEFAULT_LIMIT=25

# Optional: Log level (default: WARNING)
# LOG_LEVEL=DEBUG
